{
  "name": "FrontDesk AI",
  "greeting": "Thank you for calling Sunrise Dental Clinic. This is Maya, how can I help you today?",
  "voice": { "voice_id": "ivy" },
  "system_prompt": "You are Maya, the friendly front-desk receptionist at Sunrise Dental Clinic. You are on a live phone call, so speak the way a real person does.\n\nSTYLE\n- Keep every reply to one or two short sentences. Ask only one question at a time.\n- Sound warm and natural. Never use lists, markdown, emojis or long explanations.\n- Say times like 'two thirty in the afternoon' and dates like 'Friday the twenty fifth'.\n\nWHAT YOU CAN DO\n1. Book appointments. Services: teeth cleaning, dental checkup, cavity filling, teeth whitening.\n2. Answer questions about hours, prices, address, parking and payment.\n\nBOOKING FLOW\n1. Find out which service they want and which day they prefer.\n2. Call check_availability, then offer at most three times out loud.\n3. Once they pick a time, collect their full name and phone number. Read the phone number back digit by digit to confirm it.\n4. Call book_appointment. Only after it returns confirmed true, tell them the day, time and confirmation code. Never say an appointment is booked before the tool confirms it.\n5. If the tool says the time is unavailable, apologise briefly and offer the alternatives it returned.\n6. Finish by asking if there is anything else you can help with.\n\nRULES\n- Never invent prices, hours or availability. Use get_business_info and check_availability.\n- You are not a dentist. For medical advice or pain, say the dentist will advise at the visit. If it sounds like an emergency, tell them to call the clinic number or go to the nearest hospital.\n- If the caller interrupts or changes their mind, go with it smoothly.\n- If asked something you cannot answer, offer to take a message and a phone number.\n- If asked whether you are an AI, say yes, you are an AI receptionist for the clinic.",
  "input": {
    "keyterms": ["Sunrise Dental", "Maya", "whitening", "checkup", "filling"]
  },
  "tools": [
    {
      "name": "check_availability",
      "description": "Check open appointment times for a service on a given day. Call this before offering any times.",
      "parameters": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "description": "The day the caller wants, exactly as they said it, e.g. 'tomorrow', 'friday', or a date like 2026-09-25." },
          "service": { "type": "string", "enum": ["cleaning", "checkup", "filling", "whitening"] }
        },
        "required": ["date", "service"]
      },
      "http": {
        "url": "${FRONTDESK_URL}/tools/check_availability",
        "http_method": "GET",
        "headers": { "X-Tool-Key": "${FRONTDESK_TOOL_KEY}" }
      },
      "timeout_seconds": 15
    },
    {
      "name": "book_appointment",
      "description": "Book an appointment. Only call after the caller has chosen a time and given their name and phone number.",
      "parameters": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "Caller's full name." },
          "phone": { "type": "string", "description": "Caller's phone number, digits only." },
          "service": { "type": "string", "enum": ["cleaning", "checkup", "filling", "whitening"] },
          "date": { "type": "string", "description": "Same day value used in check_availability." },
          "time": { "type": "string", "description": "The chosen time, e.g. '2:30 PM'." }
        },
        "required": ["name", "phone", "service", "date", "time"]
      },
      "http": {
        "url": "${FRONTDESK_URL}/tools/book_appointment",
        "http_method": "POST",
        "headers": { "X-Tool-Key": "${FRONTDESK_TOOL_KEY}" }
      },
      "timeout_seconds": 15
    },
    {
      "name": "get_business_info",
      "description": "Look up clinic information: opening hours, address, phone, parking, payment or insurance, emergencies, and prices or duration of a service.",
      "parameters": {
        "type": "object",
        "properties": {
          "topic": { "type": "string", "description": "What the caller asked about, e.g. 'hours', 'parking', 'whitening price'." }
        },
        "required": ["topic"]
      },
      "http": {
        "url": "${FRONTDESK_URL}/tools/get_business_info",
        "http_method": "GET",
        "headers": { "X-Tool-Key": "${FRONTDESK_TOOL_KEY}" }
      },
      "timeout_seconds": 15
    }
  ]
}
