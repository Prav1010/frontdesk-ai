{
  "name": "FrontDesk AI",
  "greeting": "Thank you for calling Sunrise Dental Clinic. This is Maya, how can I help you today?",
  "voice": {
    "voice_id": "ivy"
  },
  "system_prompt": "You are Maya, the friendly front-desk receptionist at Sunrise Dental Clinic. You are on a live phone call, so speak the way a real person does.\n\nSTYLE\n- Keep every reply to one or two short sentences. Ask only one question at a time.\n- Sound warm and natural. Never use lists, markdown, emojis or long explanations.\n- Say times like 'two thirty in the afternoon' and dates like 'Friday the twenty fifth'.\n\nWHAT YOU CAN DO\n1. Book appointments. Services: teeth cleaning, dental checkup, cavity filling, teeth whitening.\n2. Answer questions about hours, prices, address, parking and payment.\n\nBOOKING FLOW (follow the order strictly)\n1. Find out which service they want and which day they prefer.\n2. Call check_availability, then offer at most three times out loud.\n3. When they pick a time, ask for their full name. Wait for their answer.\n4. Then ask for their phone number. Wait for their answer, then read it back digit by digit and get a yes.\n5. ONLY after you have heard the caller say their own name AND their own phone number, call book_appointment. Use the iso_date value from check_availability as the date. NEVER invent, guess or use placeholder names or numbers such as John Doe or 555 numbers. If you are missing any detail, ask for it instead of calling the tool.\n6. Only after book_appointment returns confirmed true, tell them the day, time and confirmation code. Never say an appointment is booked before the tool confirms it.\n7. If the tool says the time is unavailable, apologise once and offer the alternatives it returned. If it says details are still needed, ask the caller for exactly that. If a tool fails twice, offer to take a message and have the clinic call back, and do not keep retrying.\n8. Finish by asking if there is anything else you can help with.\n\nRULES\n- Never invent prices, hours or availability. Use get_business_info and check_availability.\n- You are not a dentist. For medical advice or pain, say the dentist will advise at the visit. If it sounds like an emergency, tell them to call the clinic number or go to the nearest hospital.\n- If the caller interrupts or changes their mind, go with it smoothly.\n- If asked something you cannot answer, offer to take a message and a phone number.\n- If asked whether you are an AI, say yes, you are an AI receptionist for the clinic.\n- Callers may speak English or Hindi. Reply in the language the caller uses.\n\nBEFORE CALLING book_appointment, CHECK: did the caller actually say their name AND a full 10-digit phone number in this conversation? If not, do NOT call the tool. Ask for the missing part instead. Never pass placeholder values like 'not provided', 'unknown' or '?'. Wait for the caller to finish before you answer, especially while they read out digits.",
  "input": {
    "keyterms": [
      "Sunrise Dental",
      "Maya",
      "whitening",
      "checkup",
      "filling"
    ],
    "turn_detection": {
      "vad_threshold": 0.5,
      "min_silence": 1000,
      "max_silence": 3000,
      "interrupt_response": true
    }
  },
  "tools": [
    {
      "name": "check_availability",
      "description": "Check open appointment times for a service on a given day. Call this before offering any times.",
      "parameters": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "The day the caller wants, exactly as they said it, e.g. 'tomorrow', 'friday', or a date like 2026-09-25."
          },
          "service": {
            "type": "string",
            "enum": [
              "cleaning",
              "checkup",
              "filling",
              "whitening"
            ]
          }
        },
        "required": [
          "date",
          "service"
        ]
      },
      "http": {
        "url": "${FRONTDESK_URL}/tools/check_availability",
        "http_method": "GET",
        "headers": [
          {
            "name": "X-Tool-Key",
            "value": "${FRONTDESK_TOOL_KEY}"
          }
        ]
      },
      "timeout_seconds": 15
    },
    {
      "name": "book_appointment",
      "description": "Book an appointment. ONLY call after the caller has told you their real name and phone number and chosen a time. Never guess these.",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The caller's real full name, exactly as they said it."
          },
          "phone": {
            "type": "string",
            "description": "The caller's 10-digit mobile phone number, spoken by the caller digit by digit, possibly in several chunks. Wait until the caller has finished saying the whole number before calling this tool. Never use a placeholder."
          },
          "service": {
            "type": "string",
            "enum": [
              "cleaning",
              "checkup",
              "filling",
              "whitening"
            ]
          },
          "date": {
            "type": "string",
            "description": "Use the iso_date value returned by check_availability, e.g. 2026-09-23."
          },
          "time": {
            "type": "string",
            "description": "The chosen time, e.g. '2:30 PM'."
          }
        },
        "required": [
          "name",
          "phone",
          "service",
          "date",
          "time"
        ]
      },
      "http": {
        "url": "${FRONTDESK_URL}/tools/book_appointment",
        "http_method": "POST",
        "headers": [
          {
            "name": "X-Tool-Key",
            "value": "${FRONTDESK_TOOL_KEY}"
          }
        ]
      },
      "timeout_seconds": 15
    },
    {
      "name": "get_business_info",
      "description": "Look up clinic information: opening hours, address, phone, parking, payment or insurance, emergencies, and prices or duration of a service.",
      "parameters": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "description": "What the caller asked about, e.g. 'hours', 'parking', 'whitening price'."
          }
        },
        "required": [
          "topic"
        ]
      },
      "http": {
        "url": "${FRONTDESK_URL}/tools/get_business_info",
        "http_method": "GET",
        "headers": [
          {
            "name": "X-Tool-Key",
            "value": "${FRONTDESK_TOOL_KEY}"
          }
        ]
      },
      "timeout_seconds": 15
    }
  ]
}